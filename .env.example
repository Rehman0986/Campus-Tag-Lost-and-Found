# Campus Tag Environment Variables Configuration

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Django Backend Configuration ---
DJANGO_SECRET_KEY="production-change-this-to-a-secure-50-char-random-string"
DJANGO_DEBUG="False"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,campustag.edu,api.campustag.edu"

# --- PostgreSQL Database ---
DB_NAME="campustag_db"
DB_USER="campustag_user"
DB_PASSWORD="campustag_secure_password"
DB_HOST="localhost"
DB_PORT="5432"

# --- SimpleJWT Token Expiry ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Redis & Celery Background Workers ---
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# --- CORS & Frontend Hostnames ---
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://campustag.edu"

# --- Super Admin Initial Setup ---
SUPERADMIN_EMAIL="admin@campustag.edu"
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_PASSWORD="CampusTag2026!SecureAdmin"
